# OS
.DS_Store

# 秘密情報・環境変数 (実体は gitignore 済みの .env に置く)
.env
.env.*
!.env.example

# エディタ・一時ファイル
*.swp
*.tmp

# ログ
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# クロールのキャッシュ・作業データ (リポジトリにはコミットしない: ADR 0006)
# 末尾に / を付けない — キャッシュを別の場所に置いて symlink を張ることがあり、
# ディレクトリ限定の指定では symlink が追跡対象に残ってしまう。
cache
data
